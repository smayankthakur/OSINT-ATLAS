# Postgres connection string (Neon / Vercel Postgres — free tier works).
# Use the POOLED connection string. Example (Neon):
# postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Windy Webcams API key (free, optional): https://api.windy.com/keys
WINDY_API_KEY=

# Shodan key — exposure-risk layer only (aggregate counts, no device access)
SHODAN_API_KEY=

# Protects /api/ingest, /api/migrate, /api/admin/approve
INGEST_SECRET=change-me

# AIS ships (free): https://aisstream.io/apikeys
AISSTREAM_API_KEY=

# Live-video DOT states (free developer keys). Add to activate each state.
# Florida: https://fl511.com/developers | Georgia: https://511ga.org/developers | NY: https://511ny.org/developers
FL511_KEY=
GA511_KEY=
NY511_KEY=
